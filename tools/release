#!/bin/sh
# Tag a release: writes index.xml (ReaPack), commits, tags and pushes. The build workflow then builds the plugin on
# macOS, Windows and Linux and attaches the three files to the GitHub release.
# usage: tools/release <version>      e.g. tools/release 0.1.0
set -e
v=${1:?usage: tools/release <version>}
cd "$(dirname "$0")/.."
repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
dl="https://github.com/$repo/releases/download/v$v"
time=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cat > index.xml <<EOF
<?xml version="1.0" encoding="utf-8"?>
<index version="1" name="bazz">
  <category name="Extensions">
    <reapack name="reaper_bazz.ext" type="extension" desc="bazz">
      <metadata>
        <description><![CDATA[Machine view: wire generators and effects into Master on a canvas. Needs ReaImGui.]]></description>
        <link rel="website">https://github.com/$repo</link>
      </metadata>
      <version name="$v" author="$(gh api user -q .login)" time="$time">
        <source platform="darwin" file="reaper_bazz.dylib">$dl/reaper_bazz.dylib</source>
        <source platform="win64" file="reaper_bazz.dll">$dl/reaper_bazz.dll</source>
        <source platform="linux64" file="reaper_bazz.so">$dl/reaper_bazz.so</source>
      </version>
    </reapack>
  </category>
</index>
EOF
git add index.xml
git commit -m "Release $v"
git tag "v$v"
git push origin HEAD "v$v"
echo "pushed v$v; the build workflow attaches the plugins to the release"
